{
  "name": "barbersalonhelp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @barbershop/web",
    "dev:api": "npm run dev --workspace @barbershop/api",
    "build": "npm run typecheck --workspace @barbershop/shared && npm run build --workspace @barbershop/api && npm run build --workspace @barbershop/web",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
