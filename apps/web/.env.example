# Browser-visible configuration. Never place service-role keys here.
# The app talks only to the Express + Supabase API backend.
VITE_DATA_BACKEND=api
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1
# Exact Supabase Storage origin used by signed shop-photo upload grants.
# This is a public URL only; never place a service-role key in a VITE_ variable.
VITE_STORAGE_ORIGIN=http://127.0.0.1:54321
